# =============================================================================
# Database
# =============================================================================
DATABASE_URL=

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Firebase (client)
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# =============================================================================
# Firebase (server / admin)
# Optional: use GOOGLE_APPLICATION_CREDENTIALS instead of explicit service account
# =============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
# GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# Upstash QStash (background jobs)
# =============================================================================
QSTASH_TOKEN=
# Required for /api/qstash/callback signature verification
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: override the full QStash callback URL
QSTASH_CALLBACK_URL=
# Upstash Workflow (app/api/workflows/*) uses the QStash token and signing keys above.
# Local dev: run `npm run workflow:dev`, then set QSTASH_URL=http://127.0.0.1:8080 and
# use the token and signing keys it prints instead of the cloud ones.
# QSTASH_URL=
# Optional: public base URL for workflow callbacks (e.g. a tunnel); defaults to NEXT_PUBLIC_APP_URL
# UPSTASH_WORKFLOW_URL=

# =============================================================================
# Bright Data (Facebook scrape)
# =============================================================================
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_WEBHOOK_AUTHORIZATION=

# =============================================================================
# TikHub (TikTok channels, keyword search, comments)
# =============================================================================
TIKHUB_API_KEY=

# =============================================================================
# Cloudflare R2 (archive scraped images/videos so expiring CDN URLs can be
# scored, embedded and displayed later)
# =============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional: private bucket for raw connector payloads (L0 archive); defaults to R2_BUCKET_NAME.
# Bright Data webhooks go to NEXT_PUBLIC_APP_URL, so local dev needs a public tunnel there.
# R2_RAW_BUCKET_NAME=
# Optional: width passed to Cloudflare Image Resizing for vision scoring (0 = off)
# R2_IMAGE_RESIZE_WIDTH=1568

# =============================================================================
# OpenAI (embeddings + scoring + classification LLM)
# =============================================================================
OPENAI_API_KEY=

# =============================================================================
# Anthropic (optional — Claude models for term backfill / rebuild)
# =============================================================================
ANTHROPIC_API_KEY=

# =============================================================================
# DeepSeek (optional — DeepSeek models for term backfill / rebuild)
# =============================================================================
DEEPSEEK_API_KEY=

# =============================================================================
# Alibaba DashScope (optional — Qwen models for term backfill / rebuild)
# =============================================================================
ALIBABA_API_KEY=
# ALIBABA_REGION=singapore
# Supported: china | singapore | us

# =============================================================================
# Local Qwen (OpenAI-compatible, e.g. qwen3-vl:8b)
# =============================================================================
LOCAL_QWEN_API_KEY=

# =============================================================================
# Exa (optional — web research for term relevance and research runs)
# =============================================================================
EXA_API_KEY=

# =============================================================================
# Unkey (API key management for external agents)
# Create an account at https://unkey.com, create an API, then copy the values.
# =============================================================================
UNKEY_ROOT_KEY=
UNKEY_API_ID=

# =============================================================================
# Alert email (Resend). Alerts are still recorded when these are missing.
# ALERT_EMAIL_FROM may be "BNB Listening <alerts@example.com>".
# =============================================================================
RESEND_API_KEY=
ALERT_EMAIL_FROM=
